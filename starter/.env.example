# Copy to .env and fill in — never commit the real file.
POSTGRES_DB=twin
POSTGRES_USER=twin
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Ignition Gateway (Docker) ---
GATEWAY_ADMIN_PASSWORD=change_me_too
TZ=America/Toronto

# --- Local MQTT (Mosquitto in docker-compose) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
INGEST_BATCH=50
INGEST_FLUSH_SEC=5

# --- AWS / cloud (optional — local path works without any of this) ---
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MLflow artifact backup: local volume by default, or s3://<bucket>/mlflow-artifacts
MLFLOW_ARTIFACT_ROOT=/mlflow-artifacts

# --- AWS IoT Core bridge (from `terraform apply` outputs) ---
AWS_IOT_ENDPOINT=
AWS_IOT_THING_NAME=twin-gateway-01
AWS_IOT_CERT_PATH=./certs/device.pem.crt
AWS_IOT_KEY_PATH=./certs/private.pem.key
AWS_IOT_CA_PATH=./certs/AmazonRootCA1.pem
